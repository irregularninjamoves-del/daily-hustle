# Render-specific Dockerfile (optimized for production)
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy backend requirements and install
# (build context is repo root, so we reference backend/)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy entire backend app
COPY backend/ .

# Run as non-root
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Render sets PORT env var, use it
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers
